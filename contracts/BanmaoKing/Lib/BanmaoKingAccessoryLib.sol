        return '';
    }

    function render(uint8 id) external view returns (string memory) {
        id = _artworkIndex(id);
        if (id >= 1 && id <= 6) return basePart.render(id);
        if (id >= 21) return expansion.render(id);
        if (id == 20) return royal.render();

/// canonical Solidity choreography by tools/bake-king-bubble-launch.cjs.
library BanmaoKingBubbleFlight {
    using Strings for uint256;
    function number(int256 n) internal pure returns (string memory) {
        return n < 0 ? string.concat('-', uint256(-n).toString()) : uint256(n).toString();
    }
    function timeValue(uint256 ms) internal pure returns (string memory) {
        return string.concat((ms / 1000).toString(), '.', ((ms % 1000) / 100).toString(), ((ms % 100) / 10).toString(), (ms % 10).toString(), 's');
    }
    function word(bytes memory data, uint256 offset) private pure returns (int256) {
        return int256(int16(uint16(uint8(data[offset])) * 256 + uint16(uint8(data[offset + 1]))));
    }
    function particle(bytes memory data, uint256 i, uint256 period, uint256 count) private pure returns (string memory) {
        int256 x = word(data, i * 8); int256 y = word(data, i * 8 + 2);
        int256 dx = word(data, i * 8 + 4); int256 dy = word(data, i * 8 + 6);
        string memory path = string.concat('M', number(x), ' ', number(y), 'q', number(dx), ' ', number(dy), ' ', number(dx), ' ', number(dy - 35));
        path = string.concat(path, 't0 -190');
        string memory begin = timeValue(i * period / count);
        string memory timing = string.concat(' begin="', begin, '" dur="', timeValue(period), '" repeatCount="indefinite"');
        // The visible flight is always five seconds; idle remainder is invisible.
        string memory active = string.concat('0.', (5000000 / period).toString());
        // Decimal key times require fixed width; period is strictly > 5s.
        string memory motion = string.concat('<animateMotion path="', path, '" keyPoints="0;1;1" keyTimes="0;', active, ';1" calcMode="linear"', timing, '/>');
        string memory fade = string.concat('<animate attributeName="opacity" values="0;.8;.65;0;0" keyTimes="0;0.01;', string.concat('0.', (4200000 / period).toString()), ';', active, ';1"', timing, '/>');
        return string.concat('<g data-free-bubble="', (i % 2).toString(), '">', motion, '<use href="#blaster-soap" opacity="0">', fade, '<animateTransform attributeName="transform" type="scale" values=".45;1;1.15;1.15" keyTimes="0;0.1;', active, ';1"', timing, '/></use></g>');
    }
    function render(uint8 expression) internal pure returns (string memory result) {
        (bytes memory data, uint256 period, uint256 count) = BanmaoKingBubbleLaunch.get(expression);
        result = '<g data-bubble-world="true" pointer-events="none">';
        for (uint256 i; i < count; i++) result = string.concat(result, particle(data, i, period, count));
        result = string.concat(result, '</g>');
    }
}

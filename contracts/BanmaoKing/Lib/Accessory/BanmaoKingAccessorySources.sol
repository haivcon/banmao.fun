        return string.concat(
            '<g data-laptop-screen="code" font-family="monospace" font-size="5.5" font-weight="500">',
            _line(string.concat('const id=', Strings.toString(tokenId), ';'), 0),
            _line(call_, 1), _line(end, 2), '</g>'

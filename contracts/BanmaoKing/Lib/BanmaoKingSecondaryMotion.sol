interface IKingSecondaryPart { function render(uint8 id) external view returns(string memory); }
contract BanmaoKingSecondaryMotion {
error InvalidTrait();
IKingSecondaryPart[21] public parts;
constructor(address[21] memory addresses){for(uint8 i=0;i<21;i++){require(addresses[i].code.length>0,"Invalid motion parts");parts[i]=IKingSecondaryPart(addresses[i]);}}
function render(uint8 id) external view returns(string memory){if(id>=21)revert InvalidTrait();return parts[id].render(id);}
}

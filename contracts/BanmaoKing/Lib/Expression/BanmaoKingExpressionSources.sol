/// @author haivcon
/// @custom:telegram https://t.me/haivcon
/// @custom:x https://x.com/haivcon
/// @custom:github https://github.com/haivcon
/// @custom:mission Dedicated to advancing Web3.
contract BanmaoKingExpressionPart4 {
error InvalidTrait();
BanmaoKingExpressionPart1 public immutable part3;
BanmaoKingExpressionPart2 public immutable part4;
BanmaoKingExpressionPart3 public immutable part5;
error InvalidPart(address part);
constructor(address p3, address p4, address p5) {
    if (p3.code.length == 0) revert InvalidPart(p3);
    if (p4.code.length == 0) revert InvalidPart(p4);
    if (p5.code.length == 0) revert InvalidPart(p5);
    part3 = BanmaoKingExpressionPart1(p3);
    part4 = BanmaoKingExpressionPart2(p4);
    part5 = BanmaoKingExpressionPart3(p5);
}
function render(uint8 id) external view returns(string memory){if(id<12||id>20)revert InvalidTrait();if(id<15)return part3.render(id);if(id<18)return part4.render(id);return part5.render(id);}
function traitName(uint8 id) external pure returns(string memory){if(id==12)return "Cosmic Wonder";if(id==13)return "Diamond Gaze";if(id==14)return "Focused Coder";if(id==15)return "Whistling";if(id==16)return "Suspicious";if(id==17)return "Angry";if(id==18)return "Determined Grin";if(id==19)return "Dreaming";if(id==20)return "Royal Decree";revert InvalidTrait();}
}

/// @author haivcon
/// @custom:telegram https://t.me/haivcon
/// @custom:x https://x.com/haivcon
/// @custom:github https://github.com/haivcon
/// @custom:mission Dedicated to advancing Web3.
contract BanmaoKingExpressionLib is IBanmaoKingExpressionLib {
    BanmaoKingExpressionPart4 public immutable expansion;
    error InvalidExpression(uint8 traitId);

    function supportsInterface(bytes4 interfaceId) external pure returns (bool) {
        return interfaceId == type(IERC165).interfaceId || interfaceId == type(IBanmaoKingExpressionLib).interfaceId;
    }

    function traitName(uint8 id) external view returns (string memory) {
        if (id >= 12) return expansion.traitName(id);
        if (id == 0) return "Happy Smile";
        if (id == 1) return "Joy";
        if (id == 2) return "Wink";
        if (id == 3) return "Love Eyes";
        if (id == 4) return "Sleepy";
        if (id == 5) return "Surprised";
        if (id == 6) return "Determined";
        if (id == 7) return "Teary";
        if (id == 8) return "Silly";
        if (id == 9) return "Cool Gaze";
        if (id == 10) return "Starstruck";
        if (id == 11) return "Zen";
        revert InvalidExpression(id);
    }

    BanmaoKingExpressionPart6 public immutable part0;
    BanmaoKingExpressionPart7 public immutable part1;
    BanmaoKingExpressionPart8 public immutable part2;
    error InvalidPart(address part);
    constructor(address p0, address p1, address p2, address expansion_) {
        if (expansion_.code.length == 0) revert InvalidPart(expansion_);
        expansion = BanmaoKingExpressionPart4(expansion_);
        if (p0.code.length == 0) revert InvalidPart(p0);
        part0 = BanmaoKingExpressionPart6(p0);
        if (p1.code.length == 0) revert InvalidPart(p1);
        part1 = BanmaoKingExpressionPart7(p1);
        if (p2.code.length == 0) revert InvalidPart(p2);
        part2 = BanmaoKingExpressionPart8(p2);
    }
    function render(uint8 id) external view returns(string memory) {
        if (id >= 12) return expansion.render(id);
        if (id < 4) return part0.render(id);
        if (id < 8) return part1.render(id);
        if (id < 12) return part2.render(id);
        revert InvalidExpression(id);
    }
}


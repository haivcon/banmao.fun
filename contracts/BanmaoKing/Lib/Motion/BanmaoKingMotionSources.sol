        bytes memory raw = bytes(values);
        values = '';
        for (uint256 i; i < raw.length; i++) values = string.concat(values, raw[i] == bytes1(';') ? ';0 ' : string(abi.encodePacked(raw[i])));
        arms = string.concat(rotate('king-staff-counter-arm', inverse(p.right), '369 345', r), rotate('king-staff-counter-wrist', inverse(BanmaoKingMotionArtwork4.wrist(id)), '369 345', r), rotate('king-staff-counter-lean', inverse(p.lean), '369 345', bodyTiming(id, p.duration)), arms);

contract BanmaoKingBackgroundExpansionPart2 { error InvalidTrait(); function render(uint8 id) external pure returns(string memory) { if(id!=14)revert InvalidTrait(); return BanmaoKingSakuraGarden.render(); } }
contract BanmaoKingBackgroundExpansion {
error InvalidTrait();
BanmaoKingBackgroundExpansionPart0 public immutable part0;
BanmaoKingBackgroundExpansionPart1 public immutable part1;
BanmaoKingBackgroundExpansionPart2 public immutable part2;
BanmaoKingRoyalBackground public immutable royal;
constructor(address[3] memory addresses,address royal_) {require(addresses[0].code.length>0,"Invalid background part");part0=BanmaoKingBackgroundExpansionPart0(addresses[0]);
require(addresses[1].code.length>0,"Invalid background part");part1=BanmaoKingBackgroundExpansionPart1(addresses[1]);
require(addresses[2].code.length>0,"Invalid background part");part2=BanmaoKingBackgroundExpansionPart2(addresses[2]);
require(royal_.code.length>0,"Invalid royal background");royal=BanmaoKingRoyalBackground(royal_);}
function render(uint8 id) external view returns(string memory){
if(id==16)return royal.render();
if(id==8||id==9||id==10)return part0.render(id);
if(id==11||id==12||id==13||id==15)return part1.render(id);
if(id==14)return part2.render(id);
revert InvalidTrait();}
function traitName(uint8 id) external pure returns(string memory){
  if (id == 16) return BanmaoKingRoyalLib.BACKGROUND_NAME;
if(id==8) return "Deep Cosmos";
if(id==9) return "Bitcoin Blocks";
if(id==10) return "Ethereum Network";
if(id==11) return "OKB Orbit";
if(id==12) return "Code Terminal";
if(id==13) return "Office";
if(id==14) return "Sakura Garden";
if(id==15) return "Royal Hall";
revert InvalidTrait();}
}

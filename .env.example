NEXT_PUBLIC_LAUNCHPAD_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_LAUNCHPAD_DEPLOYMENT_BLOCK=0
# BanmaoBox addresses are loaded from versioned files in deployments/.
# Optional per-chain overrides are intended only for local development.
# NEXT_PUBLIC_BANMAO_MAINNET_TOKEN_ADDRESS=0x...
# NEXT_PUBLIC_BANMAO_BOX_MAINNET_RENDERER_ADDRESS=0x...
# NEXT_PUBLIC_BANMAO_BOX_MAINNET_FACTORY_ADDRESS=0x...
# NEXT_PUBLIC_BANMAO_BOX_MAINNET_ADDRESS=0x...
# NEXT_PUBLIC_BANMAO_TESTNET_TOKEN_ADDRESS=0x...
# NEXT_PUBLIC_BANMAO_BOX_TESTNET_RENDERER_ADDRESS=0x...
# NEXT_PUBLIC_BANMAO_BOX_TESTNET_FACTORY_ADDRESS=0x...
# NEXT_PUBLIC_BANMAO_BOX_TESTNET_ADDRESS=0x...

NEXT_PUBLIC_XLAYER_CHAIN_ID=196
NEXT_PUBLIC_XLAYER_RPC_URL=https://rpc.xlayer.tech
NEXT_PUBLIC_XLAYER_EXPLORER_URL=https://web3.okx.com/explorer/x-layer/evm
NEXT_PUBLIC_XLAYER_TESTNET_RPC_URL=https://xlayertestrpc.okx.com/terigon
NEXT_PUBLIC_XLAYER_TESTNET_EXPLORER_URL=https://www.okx.com/web3/explorer/xlayer-test

# WalletConnect Cloud project ID used by the shared wallet modal.
# Create/manage it at https://cloud.walletconnect.com
NEXT_PUBLIC_WC_PROJECT_ID=your_walletconnect_project_id

# Required server-side only for launchpad image uploads.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# BANMAO AI server-only settings. Never prefix these with NEXT_PUBLIC_.
AI_API_KEY=server_only_api_key_here
AI_DEFAULT_MODEL=banmao.fun
AI_CHAT_ENABLED=false
AI_TOOLS_ENABLED=false
AI_RAG_ENABLED=false
AI_TX_COPILOT_ENABLED=false
# Required as true in production before Transaction Copilot can start. This
# attests that nonce/session/draft/rate-limit state is atomic and distributed.
AI_DISTRIBUTED_STATE_READY=false
AI_DEFI_ADVISOR_ENABLED=false
AI_GAMEFI_COACH_ENABLED=false
AI_COLLECTION_ADVISOR_ENABLED=false
AI_MARKET_NARRATOR_ENABLED=false

# BANMAO AI server-only authentication and read-only chain access
# Generate a high-entropy secret locally; never expose it as NEXT_PUBLIC_*.
AI_SESSION_SECRET=replace-with-at-least-32-random-characters
AI_SIWE_DOMAIN=localhost:3000
AI_SIWE_URI=http://localhost:3000
AI_SIWE_CHAIN_IDS=196
AI_NONCE_TTL_MS=300000
AI_SESSION_TTL_MS=1800000
AI_DRAFT_TTL_MS=300000
# Optional override; omit to use the canonical checked-in staking deployment.
AI_STAKE_CONTRACT=
XLAYER_RPC_URL=https://rpc.xlayer.tech
# Collection/Hub adapters use shared local server readers; no self-URL is needed.
# Optional deterministic request/orchestration budgets.
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_STREAM_BYTES=1000000
AI_MAX_REQUEST_BYTES=32000
AI_MAX_ESTIMATED_TOKENS=8000
AI_MAX_TOOL_ROUNDS=3
# Local limiter/nonce/draft stores are not production multi-instance stores.
# Configure an approved distributed store before any external canary.

NEXT_PUBLIC_LAUNCHPAD_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_LAUNCHPAD_DEPLOYMENT_BLOCK=0
# BanmaoBox addresses are loaded from versioned files in deployments/.
# Optional per-chain overrides are intended only for local development.
# Mainnet deployment uses server-side XLAYER_MAINNET_RPC_URL and
# DEPLOYER_PRIVATE_KEY from ignored .env.deploy.local. Never use NEXT_PUBLIC_.
# The deploy command additionally requires:
# BANMAOBOX_MAINNET_CONFIRM=DEPLOY_BANMAOBOX_XLAYER_196
# Replacing an existing deployment additionally requires --replace-deployment and:
# BANMAOBOX_REPLACE_CONFIRM=REPLACE_BANMAOBOX_XLAYER_196
# BANMAOBOX_DEPLOY_CONFIRMATIONS=2
# Renderer-only upgrade: npm run deploy:banmaobox:renderer:mainnet
# BANMAOBOX_RENDERER_MAINNET_CONFIRM=DEPLOY_BANMAOBOX_RENDERER_XLAYER_196
# Testnet deployment: npm run deploy:banmaobox:testnet
# XLAYER_TESTNET_RPC_URL=https://testrpc.xlayer.tech/terigon
# XLAYER_TESTNET_EXPLORER_URL=https://www.okx.com/web3/explorer/xlayer-test
# BANMAOBOX_TESTNET_CONFIRMATIONS=1
# BANMAOBOX_TESTNET_TOKEN_ADDRESS=0x... (existing ERC-20; the deploy script does not deploy a mock token)
# NEXT_PUBLIC_BANMAOBOX_TESTNET_UI=true (explicitly enables testnet in local, preview, or production builds)
# DEPLOYER_PRIVATE_KEY=0x... (server-side only; keep in ignored .env.deploy.local)
# NEXT_PUBLIC_BANMAO_MAINNET_TOKEN_ADDRESS=0x...
# NEXT_PUBLIC_BANMAO_BOX_MAINNET_RENDERER_ADDRESS=0x...
# NEXT_PUBLIC_BANMAO_BOX_MAINNET_FACTORY_ADDRESS=0x...
# NEXT_PUBLIC_BANMAO_BOX_MAINNET_ADDRESS=0x...
# Collection Explorer RPC tuning (server-side only). X Layer public RPC permits 100-block log ranges.
# BANMAOBOX_LOG_BLOCK_CHUNK=100
# BANMAOBOX_INITIAL_SCAN_BLOCKS=2000
# BanmaoBox supports X Layer mainnet (196) and testnet (1952 / 0x7A0).
NEXT_PUBLIC_XLAYER_RPC_URL=https://rpc.xlayer.tech
NEXT_PUBLIC_XLAYER_EXPLORER_URL=https://web3.okx.com/explorer/x-layer/evm
NEXT_PUBLIC_XLAYER_TESTNET_RPC_URL=https://testrpc.xlayer.tech/terigon
NEXT_PUBLIC_XLAYER_TESTNET_RPC_BACKUP_URL=https://xlayertestrpc.okx.com/terigon
NEXT_PUBLIC_XLAYER_TESTNET_EXPLORER_URL=https://www.okx.com/web3/explorer/xlayer-test

# WalletConnect Cloud project ID used by the shared wallet modal.
# Create/manage it at https://cloud.walletconnect.com
NEXT_PUBLIC_WC_PROJECT_ID=your_walletconnect_project_id

# Optional server-only Telegram companion API origin. The integration is
# disabled with HTTP 503 when unset. Use an HTTPS origin in shared environments.
TELEGRAM_API_BASE_URL=

# Required server-side only for launchpad image uploads.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Required for shared persistence in hosted environments. Use a non-production
# placeholder URL for build-only validation; never expose the auth token.
TURSO_DATABASE_URL=https://your-database.turso.io
TURSO_AUTH_TOKEN=server_only_auth_token_here

# BANMAO AI server-only settings. Never prefix these with NEXT_PUBLIC_.
AI_API_KEY=server_only_api_key_here
AI_DEFAULT_MODEL=banmao.fun
AI_CHAT_ENABLED=false
AI_TOOLS_ENABLED=false
AI_RAG_ENABLED=false
# Hybrid RAG always preserves deterministic BM25. Optional semantic providers
# must implement the local SemanticProvider interface; no embedding URL is
# assumed and chat does not fall back to another model when one is absent.
AI_TX_COPILOT_ENABLED=false
# Required as true in production before Transaction Copilot can start. This
# attests that nonce/session/draft/rate-limit state is atomic and distributed.
AI_DISTRIBUTED_STATE_READY=false
AI_DEFI_ADVISOR_ENABLED=false
AI_GAMEFI_COACH_ENABLED=false
AI_COLLECTION_ADVISOR_ENABLED=false
AI_MARKET_NARRATOR_ENABLED=false

# BANMAO AI server-only authentication and read-only chain access
# Generate a high-entropy secret locally; never expose it as NEXT_PUBLIC_*.
AI_SESSION_SECRET=replace-with-at-least-32-random-characters
AI_SIWE_DOMAIN=localhost:3000
AI_SIWE_URI=http://localhost:3000
AI_SIWE_CHAIN_IDS=196
AI_NONCE_TTL_MS=300000
AI_SESSION_TTL_MS=1800000
AI_DRAFT_TTL_MS=300000
# Optional override; omit to use the canonical checked-in staking deployment.
AI_STAKE_CONTRACT=
XLAYER_RPC_URL=https://rpc.xlayer.tech

# BanmaoBox Explorer verification (server-side only; never use NEXT_PUBLIC_).
# The existing OKX client rotates complete credential triplets with suffixes _1.._20.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_PROJECT_ID=
# Optional verifier tuning. Defaults: 60s index delay, 3 submit attempts.
BANMAOBOX_VERIFY_INDEX_DELAY_MS=60000
BANMAOBOX_VERIFY_MAX_ATTEMPTS=3
# Optional publisher CLI tuning. Defaults: 5m timeout, 15s poll interval.
BANMAOBOX_PUBLISH_TIMEOUT_MS=300000
BANMAOBOX_PUBLISH_POLL_MS=15000
BANMAOBOX_PUBLISH_REQUEST_TIMEOUT_MS=20000

# Collection/Hub adapters use shared local server readers; no self-URL is needed.
# Optional deterministic request/orchestration budgets.
# Total orchestration budget plus phase-specific upstream guards.
AI_REQUEST_TIMEOUT_MS=75000
AI_CONNECT_TIMEOUT_MS=15000
AI_STREAM_IDLE_TIMEOUT_MS=30000
# Safety-capped at one retry and only used before any model output is emitted.
AI_UPSTREAM_RETRY_LIMIT=1
AI_HEARTBEAT_INTERVAL_MS=10000
AI_MAX_STREAM_BYTES=1000000
# Allows a bounded long-context request; the model still reserves room for system/tools/output.
AI_MAX_REQUEST_BYTES=1800000
AI_MAX_ESTIMATED_TOKENS=450000
AI_MAX_TOOL_ROUNDS=3
# Local limiter/nonce/draft stores are not production multi-instance stores.
# Configure an approved distributed store before any external canary.

# Copy this file to .env.deploy.local and use a dedicated testnet-only wallet.
# Never commit .env.deploy.local or reuse a wallet holding production assets.
DEPLOYER_PRIVATE_KEY=0xYOUR_TESTNET_ONLY_PRIVATE_KEY

# Optional. The deploy script defaults to the first RPC below.
XLAYER_TESTNET_RPC_URL=https://testrpc.xlayer.tech/terigon
# Alternative: https://xlayertestrpc.okx.com/terigon

# Optional resume values: reuse an already deployed test token instead of
# deploying MockBanmao again.
# EXISTING_MOCK_BANMAO_ADDRESS=0x...
# EXISTING_MOCK_BANMAO_TX_HASH=0x...
